{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "refactor", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "docs", "release": false },
          { "type": "test", "release": false },
          { "type": "build", "release": false },
          { "type": "ci", "release": false },
          { "type": "chore", "release": false },
          { "type": "style", "release": false }
        ],
        "parserOpts": {
          "noteKeywords": ["BREAKING CHANGE", "BREAKING-CHANGE", "CAMBIO IMPORTANTE"]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Funcionalidad", "hidden": false },
            { "type": "fix", "section": "Correcciones", "hidden": false },
            { "type": "perf", "section": "Rendimiento", "hidden": false },
            { "type": "refactor", "section": "Cambios internos", "hidden": false },
            { "type": "revert", "section": "Reversiones", "hidden": false },
            { "type": "docs", "section": "Documentación", "hidden": false },
            { "type": "test", "section": "Pruebas", "hidden": false },
            { "type": "build", "section": "Dependencias y contenedores", "hidden": false },
            { "type": "ci", "section": "Integración continua", "hidden": true },
            { "type": "chore", "section": "Mantenimiento", "hidden": true },
            { "type": "style", "section": "Formato", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Historial de cambios\n\nGenerado automáticamente a partir de los mensajes de commit. No editar a mano."
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "labels": false,
        "releasedLabels": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
