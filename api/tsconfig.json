{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    // Node con ESM: las importaciones relativas llevan la extension .js
    // aunque el fichero sea .ts. Lo exige el motor, no TypeScript.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    // Sin esto, el compilador deja pasar justo lo que cuesta caro despues.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "sourceMap": true,
    "skipLibCheck": true,

    // Esta configuracion COMPRUEBA; no emite. Cubre las pruebas ademas del
    // codigo, porque una prueba que no compila es una prueba que no protege.
    // La que emite es tsconfig.build.json, y deja las pruebas fuera para que no
    // acaben dentro de la imagen.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "pruebas/**/*.ts"]
}
