# Copiar a .env y ajustar. El .env nunca se versiona.

# --- Base de datos ---
# Rol de la API: SUJETO a las politicas RLS. Nunca usar el propietario aqui.
DATABASE_URL=postgres://alivia_app:desarrollo@localhost:5434/alivia
# Rol del proceso de avisos: lee obligaciones de todos los usuarios.
DATABASE_URL_AVISOS=postgres://alivia_avisos:desarrollo@localhost:5434/alivia
# Rol propietario: solo para aplicar migraciones.
DATABASE_URL_MIGRACIONES=postgres://alivia_propietario:desarrollo@localhost:5434/alivia

# --- Correo (Mailpit) ---
SMTP_HOST=localhost
SMTP_PUERTO=1025
SMTP_REMITENTE="Alivia <avisos@alivia.local>"
# API de consulta de Mailpit, usada por las pruebas del criterio de aceptacion.
MAILPIT_API=http://localhost:8025/api/v1

# --- Aplicacion ---
PUERTO=3000
JWT_SECRETO=cambiar-en-cada-maquina
ZONA_HORARIA=America/Bogota
# Ventana de anticipacion por defecto al crear una cuenta, en dias.
DIAS_ANTICIPACION_POR_DEFECTO=15
