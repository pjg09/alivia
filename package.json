{
  "name": "alivia",
  "version": "0.0.0-gestionado-por-semantic-release",
  "private": true,
  "description": "Plataforma de recordatorios de las obligaciones de la vida adulta en Colombia",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "arrancar": "docker compose up -d --wait --build",
    "actualizar": "docker compose up -d --wait --build --force-recreate",
    "parar": "docker compose down",
    "dev": "npm run dev --workspace @alivia/api",
    "build": "npm run build --workspaces --if-present",
    "tipos": "npm run tipos --workspaces --if-present",
    "configuracion": "tsx api/src/configuracion/comprobar.ts",
    "errores": "tsx api/src/http/comprobar.ts",
    "datos": "tsx api/src/datos/comprobar.ts",
    "formato": "biome check --write",
    "formato:comprobar": "biome check",
    "verificar:backlog": "python3 scripts/verificar-backlog.py",
    "verificar:mailpit": "python3 scripts/verificar-mailpit.py",
    "verificar:commits": "commitlint --from HEAD~1 --to HEAD --verbose",
    "version:simular": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.2.0"
  },
  "workspaces": [
    "api"
  ]
}
